# Copy to .env.local and fill in real values. NEVER commit .env.local (it is gitignored).
# Placeholders only in this file — no real secrets.

# --- Payload (legacy CMS, still shares the DB) ---
PAYLOAD_SECRET=

# --- Turso (libSQL) ---
LIBSQL_URL=libsql://<your-db>.turso.io
LIBSQL_AUTH_TOKEN=

# --- Cloudflare R2 (S3-compatible media storage) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket>.r2.dev

# --- Seed-only super admin (used once by scripts/seed-admin.ts; remove after) ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# --- Auth.js (NextAuth v5) session signing secret (openssl rand -base64 32) ---
AUTH_SECRET=

# --- Razorpay (India) — fill to enable PAID registration. Free events work without it. ---
# Test keys: https://dashboard.razorpay.com/app/keys  (KEY_ID and NEXT_PUBLIC_* must be the SAME key/mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# --- Ticketing ---
# Public base URL used to build absolute ticket links + QR payloads. Prod = real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# HMAC secret for signing ticket QR tokens (openssl rand -hex 32). Rotating it invalidates all existing QRs.
TICKET_SECRET=

# --- Optional integrations ---
# DISCORD_WEBHOOK_URL=            # on-publish event notification (optional)
# NEXT_PUBLIC_SITE_URL is also read by on-publish automation
